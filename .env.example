LLM_URL=http://127.0.0.1:11434/api/chat
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT=180
OLLAMA_START_TIMEOUT=30
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=160
HF_HUB_OFFLINE=1

# Facultatif : recherche web avec liens réels provenant de Tavily.
# La clé reste dans .env et ne doit jamais être envoyée sur GitHub.
TAVILY_API_KEY=

# Passe à true uniquement si l'application est servie en HTTPS.
COOKIE_SECURE=false
